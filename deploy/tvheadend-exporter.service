[Unit]
Description=Tvheadend Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
User=tvheadend-exporter
DynamicUser=yes
EnvironmentFile=/etc/tvheadend-exporter.env
ExecStart=/usr/local/bin/tvheadend-exporter
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
