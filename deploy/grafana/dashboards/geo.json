{
  "uid": "tvh-geo",
  "title": "Tvheadend / Geo",
  "tags": [
    "tvheadend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "geomap",
      "title": "Viewers by location (24h)",
      "description": "Requires TVH_GEOIP_DB. Markers are placed by ISO country code via Grafana's built-in gazetteer; city-level detail is in the bars below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (country) (increase(tvheadend_session_seconds_total{country!=\"\",country!=\"private\"}[24h]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "w": 24,
        "h": 14,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 40,
          "lon": 0,
          "zoom": 3
        },
        "layers": [
          {
            "type": "markers",
            "name": "Viewers",
            "location": {
              "mode": "lookup",
              "lookup": "country"
            },
            "config": {
              "style": {
                "size": {
                  "field": "Value",
                  "min": 4,
                  "max": 20
                },
                "color": {
                  "fixed": "blue"
                }
              }
            }
          }
        ],
        "basemap": {
          "type": "default"
        }
      },
      "id": 1
    },
    {
      "type": "bargauge",
      "title": "Watch time by country (7d)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (country) (increase(tvheadend_session_seconds_total{country!=\"\"}[7d]))",
          "legendFormat": "{{country}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto"
      },
      "id": 2
    },
    {
      "type": "bargauge",
      "title": "Watch time by city (7d)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(20, sum by (country, city) (increase(tvheadend_session_seconds_total{city!=\"\"}[7d])))",
          "legendFormat": "{{city}} ({{country}})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto"
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Users by IP and location",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count by (user, peer, country, city) (tvheadend_subscription_info)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "w": 24,
        "h": 10,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "user": "User",
              "peer": "IP",
              "country": "Country",
              "city": "City",
              "Value": "Streams"
            }
          }
        }
      ],
      "id": 4
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ]
}
